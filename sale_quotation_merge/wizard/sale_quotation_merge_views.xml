<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_quotation_merge_form" model="ir.ui.view">
        <field name="name">sale.quotation.merge.form</field>
        <field name="model">sale.quotation.merge</field>
        <field name="arch" type="xml">
            <form string="Merge Quotations">
                <sheet>
                    <p class="text-muted">
                        The selected quotations will be merged into the target quotation. All lines will be transferred.
                    </p>
                    <group>
                        <group>
                            <field name="target_order_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="merge_lines"/>
                        </group>
                        <group>
                            <field name="action_source_orders" widget="radio"/>
                            <field name="keep_notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Selected Quotations" name="orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_merge" string="Merge Quotations" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_quotation_merge" model="ir.actions.act_window">
        <field name="name">Merge Quotations</field>
        <field name="res_model">sale.quotation.merge</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_quotation_merge_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
